# TEMPLATE ONLY - do not apply this file directly and never commit real values.
# The CD workflow (.github/workflows/cd.yml) creates/updates the real
# `app-secrets` object from GitHub Actions secrets on every deploy via:
#   kubectl create secret generic app-secrets \
#     --from-literal=JWT_PUBLIC_KEY="$JWT_PUBLIC_KEY" \
#     ... \
#     --namespace banking-system --dry-run=client -o yaml | kubectl apply -f -
#
# This file exists only to document which keys that Secret must contain.
apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: banking-system
type: Opaque
stringData:
  JWT_PRIVATE_KEY: "REPLACE_ME"   # auth-service only - RSA private key PEM, root of trust
  JWT_PUBLIC_KEY: "REPLACE_ME"    # RSA public key PEM - needed by every verifying service
  TRANSACTION_SERVICE_SECRET: "REPLACE_ME"
  FRAUD_DETECTION_SERVICE_SECRET: "REPLACE_ME"
  PAYMENT_SERVICE_SECRET: "REPLACE_ME"
  STRIPE_SECRET_KEY: "REPLACE_ME"
  STRIPE_WEBHOOK_SECRET: "REPLACE_ME"
  DB_USERNAME: "REPLACE_ME"       # shared across all 5 databases
  DB_PASSWORD: "REPLACE_ME"
  REDIS_PASSWORD: "REPLACE_ME"
  KAFKA_USERNAME: "REPLACE_ME"
  KAFKA_PASSWORD: "REPLACE_ME"
  MAIL_USERNAME: "REPLACE_ME"     # Gmail address used to send customer notification emails
  MAIL_PASSWORD: "REPLACE_ME"     # Gmail app password (not the account password)
